# Copy to .env and fill in your values. Every variable and its default is in
# config.js. Production runs on the M60e behind nginx (backend on
# 127.0.0.1:3010, see AGENTS.md); development uses its own port and database.

APP_ENV=development
HOST=0.0.0.0
PORT=3111
DB_PATH=/mnt/ssd/dev-data/mortgage-backed/game.db
JWT_SECRET=change-me-to-a-random-secret-string
# Set only while rotating JWT_SECRET (see SETUP.md), then remove.
# JWT_SECRET_PREVIOUS=
JWT_EXPIRY=30d
CORS_ORIGINS=http://100.110.102.49:3011,http://pi.taildb6607.ts.net:3011,http://localhost:3011
# Base URL put in links handed to AI agents.
PUBLIC_APP_URL=http://pi.taildb6607.ts.net:3011
REQUEST_BODY_LIMIT=256kb
ALLOW_STATE_REPAIR=false
LOG_OTPS=true
ACTION_AUDIT_LOG=true
TRUST_PROXY=false

# Rate limits: <NAME>_RATE_LIMIT_MAX and <NAME>_RATE_LIMIT_WINDOW_MS for NAME in
# AUTH, ROOM_CREATE, GAME_ACTION, REJOIN_REQUEST, REJOIN_COLLECT, MCP,
# EMAIL_SENDER, EMAIL_RECIPIENT. Defaults are in config.js.
RATE_LIMIT_ENABLED=true

# Email: a Resend-compatible HTTP API (the USESEND_ names are historical).
# Without a key no mail is sent; with LOG_OTPS=true sign-in codes are logged.
USESEND_API_KEY=
USESEND_URL=https://api.resend.com/emails
SMTP_FROM=noreply@abdlh.com

# Turn alerts (Web Push). Generate a pair with: npx web-push generate-vapid-keys
# Changing the private key drops every saved subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@abdlh.com

# Production differences:
# APP_ENV=production
# HOST=127.0.0.1
# PORT=3010
# DB_PATH=/mnt/ssd/projects/mortgage-backed/backend/game.db
# JWT_SECRET=<long-random-secret>
# CORS_ORIGINS=https://mortgage.abdlh.com
# PUBLIC_APP_URL=https://mortgage.abdlh.com
# TRUST_PROXY=loopback
# LOG_OTPS=false
